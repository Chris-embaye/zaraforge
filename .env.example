# ── ZaraForge Environment Variables — SAFE TEMPLATE ──────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# ── Admin Gateway: Secret Route Slug ─────────────────────────────────────────
# The only URL that opens the admin panel: https://yourdomain.com/?zf-access=<slug>
# Regenerate: node -e "console.log(require('crypto').randomBytes(12).toString('hex'))"
VITE_ADMIN_SLUG=change-me-unique-slug

# ── Admin IP Whitelist ────────────────────────────────────────────────────────
# Comma-separated IPv4/IPv6. Empty = allow all (dev only).
# Server enforces this; client check is advisory.
VITE_ADMIN_IP_WHITELIST=
ADMIN_IP_WHITELIST=

# ── API ───────────────────────────────────────────────────────────────────────
VITE_API_BASE=https://api.zaraforge.app
VITE_DEV_HEARTBEAT=

# ── Server-side secrets (backend only — NEVER prefix with VITE_) ─────────────
# Regenerate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HEARTBEAT_HMAC_SECRET=change-me-32-chars-minimum-secret
HEARTBEAT_JWT_SECRET=change-me-jwt-signing-secret
JWT_SECRET=change-me-session-jwt-secret
OWNER_EMAIL=your-admin-email@example.com
